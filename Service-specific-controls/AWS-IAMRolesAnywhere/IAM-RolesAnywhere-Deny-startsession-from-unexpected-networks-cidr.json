{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRolesAnywhereSessionOutsideApprovedSourceCidrs",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "rolesanywhere:CreateSession"
      ],
      "Resource": "*",
      "Condition": {
        "NotIpAddressIfExists": {
          "aws:SourceIp": ["203.0.113.0/24"]
        }
      }
    }
  ]
}