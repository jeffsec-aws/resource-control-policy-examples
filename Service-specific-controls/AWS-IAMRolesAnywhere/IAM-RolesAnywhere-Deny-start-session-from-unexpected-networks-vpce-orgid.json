{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRolesAnywhereSessionOutsideVPCeOrgID",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "rolesanywhere:CreateSession",
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIfExists": {
          "aws:VpceOrgID": "${OrganizationId}"
        }
      }
    }
  ]
}